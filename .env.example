# DataSolace local Payload CMS migration stack
# Copy to .env and fill real secrets locally. Do not commit .env.

# Optional host bind for local debug ports exposed by nginx/staging-nginx.
DATASOLACE_BIND_IP=127.0.0.1
DATASOLACE_PROD_PORT=18080
DATASOLACE_STAGING_PORT=18081
DATASOLACE_EDGE_NETWORK=datasolace-edge
NPM_MIN_PACKAGE_AGE_DAYS=14
CLOUDFLARE_TUNNEL_TOKEN=put-token-in-local-env-or-run-env-generation

# Production database/CMS secrets
POSTGRES_PASSWORD=change-me
PAYLOAD_SECRET=change-me-at-least-32-characters
PAYLOAD_DB_PUSH=true
PAYLOAD_ADMIN_EMAIL=admin@datasolace.com
PAYLOAD_ADMIN_PASSWORD=change-me
CONTACT_IP_HASH_SALT=change-me

# Production newsletter provider
KIT_API_KEY=
KIT_WEBHOOK_URL=

# Staging database/CMS secrets: must be different from production values.
STAGING_POSTGRES_PASSWORD=change-me-staging
STAGING_PAYLOAD_SECRET=change-me-staging-at-least-32-characters
STAGING_PAYLOAD_DB_PUSH=true
STAGING_PAYLOAD_ADMIN_EMAIL=admin@datasolace.com
STAGING_PAYLOAD_ADMIN_PASSWORD=change-me-staging
STAGING_CONTACT_IP_HASH_SALT=change-me-staging

# Staging newsletter provider; use test/list-safe credentials if possible.
STAGING_KIT_API_KEY=
STAGING_KIT_WEBHOOK_URL=
